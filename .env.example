# Copy to `.env` and fill in real values for your deployment.
# This repository is designed to be publishable with only fake examples.

# --- IMS / data API (optional; leave empty for offline / record-only drills) ---
DATA_API_AUTH_URL=https://api.example.com
DATA_API_USERNAME=alice@example.com
DATA_API_PASSWORD=replace-with-your-password
DATA_API_AES_KEY=replace-with-32-byte-key-example000000
DATA_API_TOKEN=

imsOSS_ACCESS_KEY_ID=replace-with-oss-ak
imsOSS_ACCESS_KEY_SECRET=replace-with-oss-sk
imsOSS_ENDPOINT=https://oss-example.aliyuncs.com
imsOSS_BUCKET=example-bucket

IMS_MCP_URL=https://api.example.com/ims/mcp/
IMS_MCP_SECRET=replace-with-your-mcp-secret

UVA_IMS_SYS_ID=0000000000000000000
UVA_IMS_FORM_ID=0000000000000000000
UVA_WATER_NAME=Example Reservoir

UVA_FRAME_INTERVAL_S=2
UVA_COOLDOWN_S=120
UVA_AUDIT_HOST=127.0.0.1
UVA_AUDIT_PORT=8020

# RTMP: empty pull/publish = local MediaMTX on 127.0.0.1:1935
UVA_RTMP_URL=rtmp://127.0.0.1:1935/live/uva
UVA_RTMP_PULL_URL=
UVA_RTMP_PUBLISH_URL=
UVA_RTMP_USER=
UVA_RTMP_PASSWORD=
UVA_RTMP_SCALE_WIDTH=1920

# Model paths (download weights separately; see README)
UVA_QWEN_DIR_PATH=model/vl/qwen-vl/2B-Instruct
UVA_YOLO_V8S_WEIGHTS=model/yolo/yolov8s.pt

# Optional SSH key for edge hops (never commit private keys)
# UVA_SSH_KEY=~/.ssh/id_rsa
