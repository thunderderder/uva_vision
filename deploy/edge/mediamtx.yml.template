logLevel: info

authMethod: internal
authInternalUsers:
  - user: __RTMP_USER__
    pass: __RTMP_PASSWORD__
    permissions:
      - action: publish
        path: live/uva
      - action: read
        path: live/uva
  - user: any
    pass: ""
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: api

api: true
apiAddress: 127.0.0.1:9997
metrics: false
pprof: false
playback: false

rtmp: true
rtmpAddress: :1935
rtmpEncryption: "no"

rtsp: false
hls: false
webrtc: false
srt: false

pathDefaults:
  source: publisher

paths:
  live/uva:
